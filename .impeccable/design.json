      "css": ".ds-song-card{display:flex;align-items:center;justify-content:space-between;gap:.75rem;width:100%;padding:.9rem 1rem;background:var(--surface,#18212b);color:var(--text,#eaf0f6);border:1px solid transparent;border-radius:12px;text-align:left;font:inherit;cursor:pointer;transition:background .15s,transform .1s}.ds-song-card:hover{background:var(--surface-2,#232f3c);border-color:var(--accent,#2f8fe0)}.ds-song-card:active{transform:scale(.98)}.ds-song-text{display:flex;flex-direction:column}.ds-song-title{font-weight:600}.ds-song-artist{font-size:.85rem;color:var(--text-muted,#8d9cac)}.ds-key{font-size:.8rem;font-weight:700;color:var(--chord,#4ba6f0);background:color-mix(in srgb,var(--chord,#4ba6f0) 14%,transparent);padding:.2rem .5rem;border-radius:6px}"
